# Copy to .env and replace every example secret before running outside local development.
DATABASE_URL=postgres://fleet:fleet_dev_password@localhost:5432/fleet_telemetry
BIND_ADDR=0.0.0.0:8080
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_TTL_SECONDS=3600
DB_MAX_CONNECTIONS=10
MAX_BATCH_SIZE=1000
LOG_FORMAT=pretty
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-password-123
RUST_LOG=info,tower_http=info,sqlx=warn
